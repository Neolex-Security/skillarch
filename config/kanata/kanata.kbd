(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
  linux-dev-names-include (
      "SteelSeries Arctis 7+"
      "SIGMACHIP Trust Keyboard Consumer Control"
      "SIGMACHIP Trust Keyboard"
      "Generic USB Audio Consumer Control"
      "SINOWEALTH Gaming KB  Keyboard"
      "SINOWEALTH Gaming KB  Consumer Control"
      "SINOWEALTH Gaming KB "
    )
)


(defsrc
  caps
  a z e r t y u i o p
  q s d f g h j k l ;     ;; <-- ; instead of m (the M-labeled key on AZERTY)
  w x c v b n m)          ;; <-- m instead of , (the ,-labeled key on AZERTY)

;; ---------- helpers ----------
(defalias
  back        (layer-switch base)
  lock-pent   (layer-switch pentest-locked)
  cesc (tap-hold 200 200
         (tap-dance 200 (esc (layer-switch creds)))
         (layer-while-held pentest))
)

(defalias
  pubuntu (multi (cmd /home/neolex/.config/kanata/payloads/type.sh ubuntu) @back)
  pfd     (multi (cmd /home/neolex/.config/kanata/payloads/type.sh fd)     @back)
)



;; ---------- payloads (auto-return to base) ----------
(defalias
  pxs  (multi (cmd /home/neolex/.config/kanata/payloads/type.sh xss)   @back)
  pxs2 (multi (cmd /home/neolex/.config/kanata/payloads/type.sh xss2)  @back)
  pxb  (multi (cmd /home/neolex/.config/kanata/payloads/type.sh xb)    @back)
  pss  (multi (cmd /home/neolex/.config/kanata/payloads/type.sh sqli)  @back)
  psa  (multi (cmd /home/neolex/.config/kanata/payloads/type.sh sqli2) @back)
  ptr  (multi (cmd /home/neolex/.config/kanata/payloads/type.sh trav)  @back)
  ptr2 (multi (cmd /home/neolex/.config/kanata/payloads/type.sh trav2) @back)
  psem (multi (cmd /home/neolex/.config/kanata/payloads/type.sh semi)  @back)
  psr  (multi (cmd /home/neolex/.config/kanata/payloads/type.sh ssrf)  @back)
  psr2 (multi (cmd /home/neolex/.config/kanata/payloads/type.sh ssrf2) @back)
  pcmd (multi (cmd /home/neolex/.config/kanata/payloads/type.sh cmd)   @back)
  ptpl (multi (cmd /home/neolex/.config/kanata/payloads/type.sh tmpl)  @back)
  plog (multi (cmd /home/neolex/.config/kanata/payloads/type.sh log4j) @back)
  poob (multi (cmd /home/neolex/.config/kanata/payloads/type.sh oob)   @back)
)

;; ---------- submenu switchers (sticky once entered) ----------
(defalias
  to-xss  (layer-switch xss)
  to-sqli (layer-switch sqli)
  to-trav (layer-switch trav)
  to-ssrf (layer-switch ssrf)
)

;; ============================================================
;; LAYERS (28 keys each)
;; ============================================================

(deflayer base
  @cesc
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

;; While HOLDING Caps:
;;   X -> xss submenu       S -> sqli submenu
;;   T -> trav submenu      R -> ssrf submenu
;;   C -> cmd injection     L -> log4j
;;   M -> template          O -> oob
(deflayer pentest
  _
  _ _ _ @to-ssrf @to-trav _ _ _ @poob @lock-pent
  _ @to-sqli _ _ _ _ _ _ @plog @ptpl
  _ @to-xss @pcmd _ _ _ _
)

(deflayer pentest-locked
  @back                                 ;; <-- tap Caps to leave
  _ _ _ @to-ssrf @to-trav _ _ _ @poob _
  _ @to-sqli _ _ _ _ _ _ @plog @ptpl
  _ @to-xss @pcmd _ _ _ _
)

;; XSS submenu (sticky): S=simple D=variant B=blind
(deflayer xss
  @back
  _ _ _ _ _ _ _ _ _ _
  _ @pxs @pxs2 _ _ _ _ _ _ _
  _ _ _ _ @pxb _ _
)

;; SQLI submenu: S=or-trick  U=union
(deflayer sqli
  @back
  _ _ _ _ _ _ @psa _ _ _
  _ @pss _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _
)

;; TRAV submenu: S=simple U=url-enc ","=/..;/
(deflayer trav
  @back
  _ _ _ _ _ _ @ptr2 _ _ _
  _ @ptr _ _ _ _ _ _ _ _
  _ _ _ _ _ _ @psem
)

;; SSRF submenu: L=localhost M=metadata O=oob
(deflayer ssrf
  @back
  _ _ _ _ _ _ _ _ @poob _
  _ _ _ _ _ _ _ _ @psr @psr2
  _ _ _ _ _ _ _
)

(deflayer creds
  @back
  _ _ _ _ _ _ @pubuntu _ _ _
  _ _ _ @pfd _ _ _ _ _ _
  _ _ _ _ _ _ _
)
